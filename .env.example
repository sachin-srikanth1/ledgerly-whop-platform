# Platform API key, from https://sandbox.whop.com/settings/developers
# Needs: company:create, company:read, checkout:create, payment:read,
#        transfer:create, transfer:read, account_link:create
WHOP_API_KEY=

# Signing secret for your webhook endpoint, shown when you register it.
# Copy it verbatim, `ws_` prefix included. Do not strip or re-encode it.
WHOP_WEBHOOK_SECRET=

# Sandbox while developing; drop the `sandbox-` prefix for production.
WHOP_API_URL=https://sandbox-api.whop.com/api/v1

# The platform's own account, prefixed `biz_`. Only needed for the transfer
# flow, where Ledgerly collects the charge and pays the seller their share.
LEDGERLY_PLATFORM_ACCOUNT_ID=
